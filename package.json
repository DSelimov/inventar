{
  "name": "inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:studio": "drizzle-kit studio --config drizzle.tenant.config.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:reset": "pnpm db:migrate && pnpm db:seed",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle.tenant.config.ts",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:pool:add": "tsx --env-file=.env src/db/pool-add.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.59.0",
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.11.0"
}
